# ==============================================================================
# DhanHQ API Credentials Template
# ==============================================================================
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_jwt_access_token_here

# ==============================================================================
# Strategy & Backtest Parameters
# ==============================================================================
INITIAL_CAPITAL=1000000.0
BACKTEST_MONTHS=24
NIFTY_LOT_SIZE=65
NUM_LOTS=2
USE_HISTORICAL_LOT_SIZES=True
EXECUTION_SLIPPAGE_PTS=2.0
RISK_REWARD_RATIO=3.0

# ==============================================================================
# Strategy Enhancement Parameters (Recommendations 1, 2, 3)
# ==============================================================================
# 1. Dynamic Risk Sizing (Fixed Fractional Sizing)
ENABLE_DYNAMIC_SIZING=True
RISK_PER_TRADE_PCT=1.0
MIN_LOTS=1
MAX_LOTS=5

# 2. Daily Trade Limits & Circuit Breaker
MAX_TRADES_PER_DAY=2
MAX_LOSSES_PER_DAY=2

# 3. Breakeven Stop-Loss Mechanism
ENABLE_BREAKEVEN=False
BREAKEVEN_R_MULTIPLE=1.5

# 4. Fresh Crossover & First Pullback Only (Fix 1: Eliminates trend churn & fee bleed)
ENFORCE_FRESH_CROSSOVER_ONLY=True

# 5. ATR Setup Candle Filter & Volatility Buffer (Fix 2: Eliminates SL_ENTRY_BAR whipsaws)
ENABLE_ATR_SETUP_FILTER=True
ATR_SETUP_MIN_MULT=0.5
ATR_SETUP_MAX_MULT=1.3
ENTRY_TRIGGER_BUFFER_PTS=2.0
SL_ATR_BUFFER_MULT=0.25

# 6. Time Entry Window (Fix 3: 09:30 to 13:15 IST avoids opening noise & fixes 15:15 payoff compression)
ENABLE_TIME_WINDOW_FILTER=True
ENTRY_WINDOW_START_TIME=09:30
ENTRY_WINDOW_END_TIME=13:15

# 7. ADX / EMA-Spread Choppiness Filter (Fix 4: Stands aside in sideways range-bound chop)
ENABLE_CHOPPINESS_FILTER=True
ADX_PERIOD=14
ADX_MIN_THRESHOLD=20.0
EMA_SPREAD_MIN_PCT=0.08

# 8. Dynamic Trailing Stop (Fix 5: 1.5R Breakeven + 4 pts, 2.0R Trail EMA 20)
ENABLE_DYNAMIC_TRAILING_STOP=True
TRAILING_R1_MULT=1.5
TRAILING_R1_OFFSET_PTS=4.0
TRAILING_R2_MULT=2.0

# ==============================================================================
# ST07: Monthly Heikin Ashi + 89 EMA Crossover Strategy
# ==============================================================================
ST07_UNIVERSE=RELIANCE
ST07_BACKTEST_YEARS=10
ST07_EMA_TREND=89
ST07_EMA_EXIT=21
ST07_WARMUP_BARS=24
ST07_SLIPPAGE_PCT=0.05


# ==============================================================================
# CAGR Performance Rating Thresholds (in %)
# ==============================================================================
CAGR_BAD_BELOW=12.0
CAGR_ACCEPTABLE_MAX=16.0
CAGR_GOOD_MIN=20.0
CAGR_EXCELLENT_MIN=30.0

# ==============================================================================
# Maximum Drawdown Rating Thresholds (in %)
# ==============================================================================
MAX_DD_EXCELLENT_BELOW=10.0
MAX_DD_GOOD_MAX=15.0
MAX_DD_ACCEPTABLE_MAX=25.0
MAX_DD_RISKY_ABOVE=25.0

# ==============================================================================
# Calmar Ratio Rating Thresholds
# ==============================================================================
CALMAR_WEAK_BELOW=1.0
CALMAR_ACCEPTABLE_MAX=2.0
CALMAR_GOOD_MAX=3.0
CALMAR_EXCELLENT_MIN=3.0

# ==============================================================================
# Sharpe Ratio Rating Thresholds
# ==============================================================================
SHARPE_WEAK_BELOW=1.0
SHARPE_ACCEPTABLE_MAX=1.5
SHARPE_GOOD_MAX=2.0
SHARPE_EXCELLENT_MIN=2.0

# ==============================================================================
# Sortino Ratio Rating Thresholds
# ==============================================================================
SORTINO_WEAK_BELOW=1.5
SORTINO_ACCEPTABLE_MAX=2.0
SORTINO_GOOD_MAX=3.0
SORTINO_EXCELLENT_MIN=3.0

# ==============================================================================
# Profit Factor Rating Thresholds
# ==============================================================================
PROFIT_FACTOR_LOSS_BELOW=1.0
PROFIT_FACTOR_WEAK_MAX=1.3
PROFIT_FACTOR_ACCEPTABLE_MAX=1.5
PROFIT_FACTOR_GOOD_MAX=2.0
PROFIT_FACTOR_EXCELLENT_MIN=2.0

# ==============================================================================
# Expectancy Rating Thresholds (Per Trade in ₹)
# ==============================================================================
EXPECTANCY_REJECT_BELOW=0.0
EXPECTANCY_WEAK_MAX=200.0
EXPECTANCY_GOOD_MIN=200.0
EXPECTANCY_GOOD_MAX=1000.0
EXPECTANCY_EXCELLENT_MIN=1000.0

# ==============================================================================
# Recovery Factor Rating Thresholds
# ==============================================================================
RECOVERY_FACTOR_WEAK_BELOW=2.0
RECOVERY_FACTOR_ACCEPTABLE_MAX=4.0
RECOVERY_FACTOR_GOOD_MIN=4.0
RECOVERY_FACTOR_GOOD_MAX=6.0
RECOVERY_FACTOR_EXCELLENT_MIN=6.0

# ==============================================================================
# Consecutive Losing Trades Rating Thresholds
# ==============================================================================
CONSEC_LOSSES_EXCELLENT_BELOW=5
CONSEC_LOSSES_GOOD_MAX=10
CONSEC_LOSSES_ACCEPTABLE_MAX=15
CONSEC_LOSSES_UNACCEPTABLE_ABOVE=15

# ==============================================================================
# Drawdown Duration Rating Thresholds (in Months)
# ==============================================================================
DD_DURATION_EXCELLENT_BELOW=3.0
DD_DURATION_GOOD_MAX=6.0
DD_DURATION_ACCEPTABLE_MAX=12.0
DD_DURATION_WEAK_ABOVE=12.0

# ==============================================================================
# Win Rate Rating Thresholds (in %)
# ==============================================================================
WIN_RATE_WEAK_BELOW=30.0
WIN_RATE_ACCEPTABLE_MAX=40.0
WIN_RATE_GOOD_MIN=40.0
WIN_RATE_GOOD_MAX=50.0
WIN_RATE_EXCELLENT_MIN=50.0

# ==============================================================================
# Avg Win / Avg Loss Ratio Rating Thresholds
# ==============================================================================
WIN_LOSS_RATIO_WEAK_BELOW=1.0
WIN_LOSS_RATIO_ACCEPTABLE_MAX=1.5
WIN_LOSS_RATIO_GOOD_MIN=1.5
WIN_LOSS_RATIO_GOOD_MAX=2.5
WIN_LOSS_RATIO_EXCELLENT_MIN=2.5


